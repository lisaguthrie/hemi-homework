#!/bin/sh
set -e

# Resolve child without committing it to the repo.
# Priority: PUBLISH_CHILD env var -> local git config hooks.child -> DEFAULT_CHILD env var.
CHILD="${PUBLISH_CHILD:-$(git config --get hooks.child || true)}"
if [ -z "$CHILD" ]; then
  CHILD="${DEFAULT_CHILD:-}"
fi
if [ -z "$CHILD" ]; then
  echo "Missing child. Set one with: git config --local hooks.child <name>"
  echo "Or set env var PUBLISH_CHILD (or DEFAULT_CHILD)."
  exit 1
fi

# Regenerate docs and block push if docs/ changed and is uncommitted.
python runners/publish.py --child "$CHILD"

if ! git diff --quiet -- docs; then
  echo "docs/ changed after publish. Commit docs/ before pushing."
  git status --short docs
  exit 1
fi
